#!/usr/bin/env bash
set -euo pipefail
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3) )); then
  printf 'bash >= 4.3 required\n' >&2
  exit 1
fi
SSHX_VERSION="4.1"
SSHX_LICENSE="GPL-3.0"
SSHX_HOME="${SSHX_HOME:-$HOME/.sshx}"
SSH_HOME="${SSH_HOME:-$HOME/.ssh}"
SSH_BIN="${SSH_BIN:-ssh}"
SSHX_CONNECTIONS_DIR="$SSHX_HOME/connections"
SSHX_BACKUPS_DIR="$SSHX_HOME/backups"
SSHX_TAGS_DIR="$SSHX_HOME/tags"
SSHX_CONFIG="$SSHX_HOME/config"
SSH_CONFIG="$SSH_HOME/config"
declare -A SSH_FLAG_MAP=(
  [host]=HostName [user]=User [port]=Port [address-family]=AddressFamily
  [bind-address]=BindAddress [connect-timeout]=ConnectTimeout [identity]=IdentityFile
  [identity-agent]=IdentityAgent [pubkey-auth]=PubkeyAuthentication [password-auth]=PasswordAuthentication
  [kbd-interactive]=KbdInteractiveAuthentication [gssapi-auth]=GSSAPIAuthentication [gssapi-delegate]=GSSAPIDelegateCredentials
  [preferred-auth]=PreferredAuthentications [host-based-auth]=HostbasedAuthentication [number-of-password-prompts]=NumberOfPasswordPrompts
  [strict-host-key-checking]=StrictHostKeyChecking [known-hosts]=UserKnownHostsFile [global-known-hosts]=GlobalKnownHostsFile
  [host-key-algorithms]=HostKeyAlgorithms [check-host-ip]=CheckHostIP [verify-host-key-dns]=VerifyHostKeyDNS [revoked-host-keys]=RevokedHostKeys
  [ciphers]=Ciphers [macs]=MACs [kex-algorithms]=KexAlgorithms [pubkey-accepted-algorithms]=PubkeyAcceptedAlgorithms
  [ca-signature-algorithms]=CASignatureAlgorithms [required-rsa-size]=RequiredRSASize [jump]=ProxyJump [proxy-command]=ProxyCommand
  [local-forward]=LocalForward [remote-forward]=RemoteForward [dynamic-forward]=DynamicForward [exit-on-forward-failure]=ExitOnForwardFailure
  [clear-all-forwardings]=ClearAllForwardings [control-master]=ControlMaster [control-path]=ControlPath [control-persist]=ControlPersist
  [server-alive-interval]=ServerAliveInterval [server-alive-count-max]=ServerAliveCountMax [tcp-keepalive]=TCPKeepAlive [forward-agent]=ForwardAgent
  [forward-x11]=ForwardX11 [forward-x11-trusted]=ForwardX11Trusted [forward-x11-timeout]=ForwardX11Timeout [request-tty]=RequestTTY [send-env]=SendEnv
  [set-env]=SetEnv [accept-env]=AcceptEnv [remote-command]=RemoteCommand [permit-local-command]=PermitLocalCommand [local-command]=LocalCommand
  [compression]=Compression [log-level]=LogLevel [escape-char]=EscapeChar [hash-known-hosts]=HashKnownHosts [add-keys-to-agent]=AddKeysToAgent
  [rekey-limit]=RekeyLimit [session-type]=SessionType [stdin-null]=StdinNull [fork-after-authentication]=ForkAfterAuthentication [tunnel]=Tunnel
  [tunnel-device]=TunnelDevice [permit-remote-open]=PermitRemoteOpen [security-key-provider]=SecurityKeyProvider [pkcs11-provider]=PKCS11Provider
  [ignored-unknown]=IgnoredUnknownOption
)
_check_deps() {
  local missing=()
  for _cmd in awk sort find mktemp tr; do
    command -v "$_cmd" &>/dev/null || missing+=("$_cmd")
  done
  [[ ${#missing[@]} -eq 0 ]] || { printf 'sshx: missing required tools: %s\n' "${missing[*]}" >&2; exit 1; }
}
_check_deps

_use_color() {
  [[ "${NO_COLOR:-}" == "1" ]] && return 1
  [[ "${FORCE_COLOR:-}" == "1" ]] && return 0
  [[ -t 1 ]]
}
color() {
  _use_color || return 0
  case "$1" in
    reset) printf '\033[0m' ;;
    bold) printf '\033[1m' ;;
    red) printf '\033[31m' ;;
    green) printf '\033[32m' ;;
    yellow) printf '\033[33m' ;;
    cyan) printf '\033[36m' ;;
    gray) printf '\033[90m' ;;
  esac
}
die() { printf '%s✗ %s%s\n' "$(color red)" "$*" "$(color reset)" >&2; exit 1; }
ok()  { printf '%s✓ %s%s\n' "$(color green)" "$*" "$(color reset)"; }
info(){ printf '%s· %s%s\n' "$(color cyan)" "$*" "$(color reset)"; }
warn(){ printf '%s⚠ %s%s\n' "$(color yellow)" "$*" "$(color reset)" >&2; }
confirm() {
  local prompt="${1:-Are you sure?}" reply
  printf '%s%s [y/N] %s' "$(color yellow)" "$prompt" "$(color reset)" >&2
  read -r reply </dev/tty
  [[ "$reply" =~ ^[Yy]$ ]]
}
print_table() {
  local no_header=false
  [[ "${1:-}" == "--no-header" ]] && no_header=true
  if ! command -v column &>/dev/null; then cat; return; fi
  if "$no_header"; then
    column -t -s $'\t'
  else
    local first=true line
    while IFS= read -r line; do
      if "$first"; then
        first=false
        _use_color && printf '\033[1m%s\033[0m\n' "$line" || printf '%s\n' "$line"
      else
        printf '%s\n' "$line"
      fi
    done | column -t -s $'\t'
  fi
}
_LOCK_ACQUIRED=false
check_lock() {
  mkdir -p "$SSHX_HOME"
  if command -v flock &>/dev/null; then
    exec 200>"$SSHX_HOME/.lock"
    flock -n 200 || die "Could not acquire lock. Another sshx is running."
  else
    local lockdir="$SSHX_HOME/.lock.d"
    local retries=0
    until mkdir "$lockdir" 2>/dev/null; do
      (( retries++ > 10 )) && die "Could not acquire lock. Another sshx is running."
      sleep 0.2
    done
    printf '%s' "$$" > "$lockdir/pid"
  fi
  _LOCK_ACQUIRED=true
}
release_lock() {
  if command -v flock &>/dev/null; then
    flock -u 200 2>/dev/null || true
  else
    rm -rf "$SSHX_HOME/.lock.d" 2>/dev/null || true
  fi
  _LOCK_ACQUIRED=false
}
declare -a _TEMP_FILES=()
_cleanup() {
  local f
  for f in "${_TEMP_FILES[@]:-}"; do rm -f "$f" 2>/dev/null; done
  [[ "$_LOCK_ACQUIRED" == true ]] && release_lock 2>/dev/null || true
}
trap _cleanup EXIT INT TERM HUP

atomic_write() {
  local dest="$1" tmp
  tmp=$(mktemp "${dest}.XXXXXX")
  _TEMP_FILES+=("$tmp")
  chmod 600 "$tmp"
  cat > "$tmp"
  mv "$tmp" "$dest"
  # Remove from temp list after successful mv
  local new=()
  local f; for f in "${_TEMP_FILES[@]:-}"; do [[ "$f" != "$tmp" ]] && new+=("$f"); done
  _TEMP_FILES=("${new[@]:-}")
}
declare -A DEFAULT_CFG=(
  [backup_enabled]=true
  [backup_max_age_days]=30
  [color]=1
  [fzf_preview]=false
  [default_tags]=""
  [editor]="${EDITOR:-vim}"
)
cfg_get() {
  local key="$1" default="${2:-}" result
  if [[ -f "$SSHX_CONFIG" ]]; then
    result=$(awk -F'=' -v k="$key" '$1==k{print substr($0,index($0,"=")+1); exit}' "$SSHX_CONFIG" 2>/dev/null)
    if [[ -n "$result" ]]; then
      printf '%s' "$result"
    else
      printf '%s' "${default:-${DEFAULT_CFG[$key]:-}}"
    fi
  else
    printf '%s' "${default:-${DEFAULT_CFG[$key]:-}}"
  fi
}
cfg_set() {
  local key="$1" value="$2"
  mkdir -p "$(dirname "$SSHX_CONFIG")"
  touch "$SSHX_CONFIG"
  local tmp; tmp=$(mktemp)
  _TEMP_FILES+=("$tmp")
  awk -v k="$key" -v v="$value" '
    $0 ~ ("^" k "=") { print k "=" v; seen=1; next }
    { print }
    END { if (!seen) print k "=" v }
  ' "$SSHX_CONFIG" > "$tmp"
  mv "$tmp" "$SSHX_CONFIG"
  _TEMP_FILES=("${_TEMP_FILES[@]/$tmp}")
}
cmd_config_get() {
  local key="${1:-}"
  if [[ -n "$key" ]]; then
    cfg_get "$key"; printf '\n'
  else
    local keys=(editor backup_enabled backup_max_age_days color fzf_preview default_tags)
    for k in "${keys[@]}"; do printf '%-26s %s\n' "$k" "$(cfg_get "$k")"; done
  fi
}
cmd_config_set() {
  [[ $# -ge 2 ]] || die "Usage: sshx config set KEY VALUE"
  cfg_set "$1" "$2"; ok "Set $1=$2"
}
utc_now() { date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date +%Y-%m-%dT%H:%M:%SZ; }
json_escape() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  s="${s//$'\b'/\\b}"
  s="${s//$'\f'/\\f}"
  # Strip remaining ASCII control characters (U+0000–U+001F)
  s=$(printf '%s' "$s" | tr -d '\000-\037' 2>/dev/null || printf '%s' "$s")
  printf '%s' "$s"
}
parse_conn_string() {
  local cs="$1"
  local -n _pu="$2" _ph="$3" _pp="$4"
  _pu="" _ph="" _pp="22"
  [[ "$cs" == *"@"* ]] && { _pu="${cs%%@*}"; cs="${cs#*@}"; }
  if [[ "$cs" =~ ^\[([^\]]+)\]:([0-9]+)$ ]]; then _ph="${BASH_REMATCH[1]}"; _pp="${BASH_REMATCH[2]}"
  elif [[ "$cs" =~ ^\[([^\]]+)\]$ ]]; then _ph="${BASH_REMATCH[1]}"
  elif [[ "$cs" =~ ^([^:]+):([0-9]+)$ ]]; then _ph="${BASH_REMATCH[1]}"; _pp="${BASH_REMATCH[2]}"
  else _ph="$cs"; fi
}
# Single-pass parser: reads all fields from one conn file in one awk invocation
# Outputs: name TAB host TAB port TAB user TAB desc TAB tags TAB created TAB updated
_parse_conn_file_fields() {
  local file="$1"
  awk '
    /^# sshx:name=/       { name   = substr($0, index($0,"=")+1) }
    /^# sshx:description=/{ desc   = substr($0, index($0,"=")+1) }
    /^# sshx:tags=/       { tags   = substr($0, index($0,"=")+1) }
    /^# sshx:created_at=/ { created= substr($0, index($0,"=")+1) }
    /^# sshx:updated_at=/ { updated= substr($0, index($0,"=")+1) }
    /^[[:space:]]*HostName[[:space:]]/ { host = $2 }
    /^[[:space:]]*Port[[:space:]]/     { port = $2 }
    /^[[:space:]]*User[[:space:]]/     { user = $2 }
    END {
      if (!port)    port    = "22"
      if (!user)    user    = "-"
      if (!desc)    desc    = "-"
      if (!tags)    tags    = "-"
      if (!created) created = "-"
      if (!updated) updated = "-"
      printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", name, host, port, user, desc, tags, created, updated
    }
  ' "$file"
}
conn_files() {
  shopt -s nullglob
  local f
  for f in "$SSHX_CONNECTIONS_DIR"/*.conf; do printf '%s\n' "$f"; done | sort
  shopt -u nullglob
}
conn_meta() {
  local file="$1" field="$2"
  awk -F'=' -v f="$field" 'BEGIN{pat="# sshx:" f "="} index($0,pat)==1{print substr($0,length(pat)+1); exit}' "$file" 2>/dev/null || true
}
conn_ssh() {
  local file="$1" key="$2"
  local key_lower; key_lower=$(printf '%s' "$key" | tr '[:upper:]' '[:lower:]')
  awk -v k="$key_lower" '
    /^[[:space:]]*[^#]/ {
      if (tolower($1) == "host") { inhost = 1 }
      if (inhost && tolower($1) == k) { print $2; exit }
    }
  ' "$file" 2>/dev/null || true
}
conn_file() {
    printf '%s/%s.conf' "$SSHX_CONNECTIONS_DIR" "$1"
}
conn_validate_name() {
  [[ "$1" =~ ^[a-zA-Z0-9._-]+$ ]] || { printf 'Invalid name "%s". Use [a-zA-Z0-9._-] only.\n' "$1" >&2; return 1; }
}
conn_validate_name_or_die() {
  conn_validate_name "$1" || die "Invalid name '${1}'. Use [a-zA-Z0-9._-] only."
}
write_conn_file() {
  local file="$1" name="$2" conn_str="$3"
  local description="${4:-}" tags="${5:-}" created_at="${6:-}"
  local now; now=$(utc_now)
  [[ -n "$created_at" ]] || created_at="$now"
  local def_tags; def_tags=$(cfg_get default_tags)
  if [[ -n "$def_tags" ]]; then
    # Merge and deduplicate tags + default_tags
    local -A _seen=()
    local -a _merged=()
    local _t _all="${tags},${def_tags}"
    IFS=',' read -ra _arr <<< "$_all"
    for _t in "${_arr[@]}"; do
      _t="${_t//[[:space:]]/}"
      [[ -z "$_t" || -n "${_seen[$_t]:-}" ]] && continue
      _seen[$_t]=1; _merged+=("$_t")
    done
    tags=$(IFS=','; printf '%s' "${_merged[*]:-}")
  fi
  local user host port
  parse_conn_string "$conn_str" user host port
  {
    printf '# sshx:name=%s\n' "$name"
    [[ -n "$description" ]] && printf '# sshx:description=%s\n' "$description"
    [[ -n "$tags" ]] && printf '# sshx:tags=%s\n' "$tags"
    printf '# sshx:created_at=%s\n' "$created_at"
    printf '# sshx:updated_at=%s\n' "$now"
    printf '# sshx:connection_string=%s\n' "$conn_str"
    printf '\n'
    printf 'Host %s\n' "$name"
    printf '    HostName %s\n' "$host"
    [[ -n "$user" ]] && printf '    User %s\n' "$user"
    [[ "$port" != "22" && -n "$port" ]] && printf '    Port %s\n' "$port"
  } | atomic_write "$file"
  chmod 600 "$file"
}
update_meta() {
  local file="$1" field="$2" value="$3" tmp
  tmp=$(mktemp); chmod 600 "$tmp"
  if awk -v f="$field" 'BEGIN{pat="# sshx:" f "="} index($0,pat)==1{print; found=1; next} {print} END{if(!found) exit 2}' "$file" >/dev/null 2>&1; then
    awk -v f="$field" -v v="$value" 'BEGIN{pat="# sshx:" f "="} index($0,pat)==1{sub(/^# sshx:[^=]+=.*/,"# sshx:" f "=" v)} {print}' "$file" > "$tmp"
  else
    awk -v f="$field" -v v="$value" 'BEGIN{done=0} /^# sshx:/ && !done{print; print "# sshx:" f "=" v; done=1; next} {print}' "$file" > "$tmp"
  fi
  mv "$tmp" "$file"; chmod 600 "$file"
}
update_ssh_directive() {
  local file="$1" directive="$2" value="$3" tmp hname
  hname=$(awk -F'=' '/^# sshx:name=/{print substr($0,index($0,"=")+1); exit}' "$file" 2>/dev/null || true)
  local dir_lower; dir_lower=$(printf '%s' "$directive" | tr '[:upper:]' '[:lower:]')
  tmp=$(mktemp); _TEMP_FILES+=("$tmp"); chmod 600 "$tmp"
  awk -v hname="$hname" -v d="$directive" -v dlo="$dir_lower" -v v="$value" '
  BEGIN{inblock=0; done=0}
  {
    if(tolower($1)=="host"){
      if(inblock && !done){ printf "    %s %s\n", d, v; done=1 }
      inblock=0
      if($2==hname) inblock=1
      print; next
    }
    if(inblock){
      line=$0; gsub(/^[[:space:]]+/,"",line)
      split(line, arr, /[[:space:]]+/)
      if(tolower(arr[1])==dlo){ printf "    %s %s\n", d, v; done=1; next }
    }
    print
  }
  END{ if(inblock && !done) printf "    %s %s\n", d, v }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"; chmod 600 "$file"
}
remove_ssh_directive() {
  local file="$1" directive="$2" tmp
  local dir_lower; dir_lower=$(printf '%s' "$directive" | tr '[:upper:]' '[:lower:]')
  tmp=$(mktemp); _TEMP_FILES+=("$tmp"); chmod 600 "$tmp"
  awk -v dlo="$dir_lower" '{
    line=$0; gsub(/^[[:space:]]+/,"",line)
    split(line, a, /[[:space:]]+/)
    if(tolower(a[1])==dlo) next
    print
  }' "$file" > "$tmp" 2>/dev/null || true
  mv "$tmp" "$file"; chmod 600 "$file"
}
touch_updated() { update_meta "$1" updated_at "$(utc_now)"; }
backup_conn() {
  [[ "$(cfg_get backup_enabled)" == "true" ]] || return 0
  [[ -f "$1" ]] || return 0
  local ts; ts=$(utc_now | tr -d ':-')
  mkdir -p "$SSHX_BACKUPS_DIR"
  cp "$1" "${SSHX_BACKUPS_DIR}/$(basename "$1").${ts}"
}
backups_prune() {
  local max; max=$(cfg_get backup_max_age_days)
  [[ -d "$SSHX_BACKUPS_DIR" ]] || return 0
  [[ "$max" =~ ^[0-9]+$ ]] || max=30   # защита от некорректного значения
  find "$SSHX_BACKUPS_DIR" -maxdepth 1 -name "*.conf.*" -mtime "+${max}" -delete 2>/dev/null || true
}
apply_ssh_flags() {
  local file="$1"; shift
  while [[ $# -gt 0 ]]; do
    local token="$1" flag val=""
    if [[ "$token" == *=* ]]; then
      flag="${token%%=*}"; val="${token#*=}"; flag="${flag#--}"; shift
    else
      flag="${token#--}"; shift
      if [[ $# -gt 0 && "$1" != --* ]]; then val="$1"; shift; fi
    fi
    if [[ -n "${SSH_FLAG_MAP[$flag]:-}" ]]; then
      update_ssh_directive "$file" "${SSH_FLAG_MAP[$flag]}" "$val"
    else
      warn "Unknown SSH option --${flag} (skipped)"
    fi
  done
}
cmd_connect() {
  local dry_run=false name="" extra_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=true; shift ;;
      --help|-h) printf 'Usage: sshx connect [NAME] [SSH_ARGS...]\n\nOptions:\n  --dry-run  Print command without executing\n'; return ;;
      -*) extra_args+=("$1"); shift ;;
      *) [[ -z "$name" ]] && name="$1" || extra_args+=("$1"); shift ;;
    esac
  done
  if [[ -z "$name" ]]; then
    command -v fzf &>/dev/null || die "NAME required. Install fzf for interactive selection."
    local fzf_opts=()
    [[ "$(cfg_get fzf_preview)" == "true" ]] && fzf_opts+=(--preview "cat \"$SSHX_CONNECTIONS_DIR/{}.conf\" 2>/dev/null")
    name=$(conn_files | xargs -I{} basename {} .conf | fzf --height=40% --reverse "${fzf_opts[@]}" 2>/dev/null) || die "No connection selected."
  fi
  local file; file=$(conn_file "$name")
  [[ -f "$file" ]] || die "Connection '$name' not found."
  local cmd=()
  cmd+=("$SSH_BIN")
  cmd+=("$name")
  if [[ ${#extra_args[@]} -gt 0 ]]; then cmd+=("${extra_args[@]}"); fi
  if $dry_run; then info "Would run: ${cmd[*]}"; return; fi
  exec "${cmd[@]}"
}
cmd_list() {
  local tag_filter=() format="table" sort_field="name" reverse=false no_header=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tag) tag_filter+=("$2"); shift 2 ;;
      --format) format="$2"; shift 2 ;;
      --sort) sort_field="$2"; shift 2 ;;
      --reverse|-r) reverse=true; shift ;;
      --no-header) no_header=true; shift ;;
      --json) format="json"; shift ;;
      --help|-h) printf 'Usage: sshx list [--tag TAG] [--format table|wide|json|ssh] [--sort name|host|port|created|updated] [--reverse] [--no-header]\n'; return ;;
      *) die "Unknown flag: $1" ;;
    esac
  done
  local -a files=()
  while IFS= read -r f; do [[ -n "$f" ]] && files+=("$f"); done < <(conn_files)
  [[ ${#files[@]} -gt 0 ]] || { info "No connections. Run 'sshx add NAME USER@HOST' to create one."; return; }
  local -a rows=()
  for f in "${files[@]}"; do
    local raw name host port user desc tags created updated
    raw=$(_parse_conn_file_fields "$f")
    IFS=$'\t' read -r name host port user desc tags created updated <<< "$raw"
    if [[ ${#tag_filter[@]} -gt 0 ]]; then
      local match=true tf
      for tf in "${tag_filter[@]}"; do [[ ",${tags}," == *",${tf},"* ]] || { match=false; break; }; done
      $match || continue
    fi
    rows+=("${name}|${host}|${port}|${user}|${desc}|${tags}|${created}|${updated}")
  done
  [[ ${#rows[@]} -gt 0 ]] || { info "No connections match the filter."; return; }
  local sort_col=0
  case "$sort_field" in host) sort_col=1;; port) sort_col=2;; created) sort_col=6;; updated) sort_col=7;; esac
  local sort_flags=("-t|" "-k$((sort_col+1))")
  $reverse && sort_flags+=("-r")
  IFS=$'\n' read -r -d '' -a rows < <(printf '%s\n' "${rows[@]}" | sort "${sort_flags[@]}" && printf '\0')
  case "$format" in
    json)
      printf '[\n'
      local first=true
      for row in "${rows[@]}"; do
        IFS='|' read -r n h po u d tg cr up <<< "$row"
        $first || printf ',\n'
        first=false
        printf '  {"name":"%s","host":"%s","port":"%s","user":"%s","description":"%s","tags":"%s","created_at":"%s","updated_at":"%s"}' \
          "$(json_escape "$n")" "$(json_escape "$h")" "$(json_escape "$po")" "$(json_escape "$u")" \
          "$(json_escape "$d")" "$(json_escape "$tg")" "$(json_escape "$cr")" "$(json_escape "$up")"
      done
      printf '\n]\n'
      ;;
    ssh)
      for row in "${rows[@]}"; do
        IFS='|' read -r n h po u _ _ _ _ <<< "$row"
        printf 'Host %s\n    HostName %s\n    Port %s\n' "$n" "$h" "$po"
        [[ "$u" != "-" ]] && printf '    User %s\n' "$u"
        printf '\n'
      done
      ;;
    wide|*)
      local header_line
      if [[ "$format" == "wide" ]]; then
        header_line='NAME\tHOST\tPORT\tUSER\tDESCRIPTION\tTAGS\tUPDATED'
      else
        header_line='NAME\tHOST\tPORT\tDESCRIPTION\tTAGS'
      fi
      {
        $no_header || printf '%b\n' "$header_line"
        for row in "${rows[@]}"; do
          IFS='|' read -r n h po u d tg _ up <<< "$row"
          if [[ "$format" == "wide" ]]; then printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$n" "$h" "$po" "$u" "$d" "$tg" "$up"
          else printf '%s\t%s\t%s\t%s\t%s\n' "$n" "$h" "$po" "$d" "$tg"; fi
        done
      } | if $no_header; then print_table --no-header; else print_table; fi
      ;;
  esac
}
cmd_search() {
  local term="" field="any" regex=false format="table"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --field) field="$2"; shift 2 ;;
      --regex) regex=true; shift ;;
      --format) format="$2"; shift 2 ;;
      --json) format="json"; shift ;;
      --help|-h) printf 'Usage: sshx search TERM [--field name|host|user|desc|tag|any] [--regex] [--format table|json]\n'; return ;;
      *) term="$1"; shift ;;
    esac
  done
  [[ -n "$term" ]] || die "TERM required. Usage: sshx search TERM"
  local -a results=()
  while IFS= read -r f; do
    local name host user desc tags haystack
    name=$(conn_meta "$f" name); host=$(conn_ssh "$f" HostName)
    user=$(conn_ssh "$f" User); desc=$(conn_meta "$f" description)
    tags=$(conn_meta "$f" tags)
    case "$field" in
      name) haystack="$name" ;; host) haystack="$host" ;;
      user) haystack="$user" ;; desc) haystack="$desc" ;;
      tag) haystack="$tags" ;; *) haystack="$name $host $user $desc $tags" ;;
    esac
    local matched=false
    if $regex; then
      if [[ "$haystack" =~ $term ]]; then matched=true; fi
    else
      if [[ "$haystack" == *"$term"* ]]; then matched=true; fi
    fi
    $matched && results+=("${name}|${host}|${desc}|${tags}")
  done < <(conn_files)
  [[ ${#results[@]} -gt 0 ]] || { info "No connections match '${term}'."; return; }
  if [[ "$format" == "json" ]]; then
    printf '[\n'
    local first=true
    for r in "${results[@]}"; do
      IFS='|' read -r n h d tg <<< "$r"
      $first || printf ',\n'
      first=false
      printf '  {"name":"%s","host":"%s","description":"%s","tags":"%s"}' \
        "$(json_escape "$n")" "$(json_escape "$h")" "$(json_escape "$d")" "$(json_escape "$tg")"
    done
    printf '\n]\n'
  else
    {
      printf 'NAME\tHOST\tDESCRIPTION\tTAGS\n'
      for r in "${results[@]}"; do
        IFS='|' read -r n h d tg <<< "$r"
        printf '%s\t%s\t%s\t%s\n' "$n" "$h" "$d" "$tg"
      done
    } | print_table
  fi
}
_tags_sync() {
  local name="$1" tags_str="$2"
  _tags_remove_all "$name"
  [[ -z "$tags_str" ]] && return
  IFS=',' read -ra tag_arr <<< "$tags_str"
  for tag in "${tag_arr[@]}"; do
    tag="${tag//[[:space:]]/}"; [[ -z "$tag" ]] && continue
    local tag_dir="$SSHX_TAGS_DIR/$tag"
    mkdir -p "$tag_dir"
    local abs_target
    if [[ -d "$SSHX_CONNECTIONS_DIR" ]]; then
      abs_target="$(cd "$SSHX_CONNECTIONS_DIR" && pwd -P)/${name}.conf"
    else
      abs_target="${SSHX_CONNECTIONS_DIR}/${name}.conf"
    fi
    ln -sf "$abs_target" "$tag_dir/${name}"
  done
}
_tags_remove_all() {
  [[ -d "$SSHX_TAGS_DIR" ]] || return 0
  find "$SSHX_TAGS_DIR" -name "$1" -type l -delete 2>/dev/null || true
  find "$SSHX_TAGS_DIR" -mindepth 1 -maxdepth 1 -type d -empty -delete 2>/dev/null || true
}
cmd_tag_add() {
  [[ $# -ge 2 ]] || die "Usage: sshx tag add NAME TAG[,TAG2,...]"
  local name="$1" new_str="$2"
  [[ -f "$(conn_file "$name")" ]] || die "Connection '$name' not found."
  local file; file=$(conn_file "$name")
  local current; current=$(conn_meta "$file" tags)
  declare -A seen=()
  local -a merged=()
  local t arr1 arr2
  IFS=',' read -ra arr1 <<< "$current"
  IFS=',' read -ra arr2 <<< "$new_str"
  for t in "${arr1[@]}" "${arr2[@]}"; do
    t="${t//[[:space:]]/}"; [[ -z "$t" || -n "${seen[$t]:-}" ]] && continue
    seen[$t]=1; merged+=("$t")
  done
  local result; result=$(IFS=','; printf '%s' "${merged[*]}")
  check_lock
  backup_conn "$file"
  update_meta "$file" tags "$result"
  touch_updated "$file"
  _tags_sync "$name" "$result"
  backups_prune
  release_lock
  ok "Tags for '${name}': ${result}"
}
cmd_tag_remove() {
  [[ $# -ge 2 ]] || die "Usage: sshx tag remove NAME TAG[,TAG2,...]"
  local name="$1" rm_str="$2"
  [[ -f "$(conn_file "$name")" ]] || die "Connection '$name' not found."
  local file; file=$(conn_file "$name")
  local current; current=$(conn_meta "$file" tags)
  declare -A drop=(); local t
  IFS=',' read -ra rm_arr <<< "$rm_str"
  for t in "${rm_arr[@]}"; do drop[${t//[[:space:]]/}]=1; done
  local -a keep=()
  IFS=',' read -ra existing <<< "$current"
  for t in "${existing[@]}"; do
    t="${t//[[:space:]]/}"; [[ -z "$t" || -n "${drop[$t]:-}" ]] && continue; keep+=("$t")
  done
  local result; result=$(IFS=','; printf '%s' "${keep[*]:-}")
  check_lock
  backup_conn "$file"
  update_meta "$file" tags "$result"
  touch_updated "$file"
  _tags_sync "$name" "$result"
  backups_prune
  release_lock
  ok "Tags for '${name}': ${result:-<none>}"
}
cmd_tag_list() {
  declare -A counts=()
  while IFS= read -r f; do
    local tags; tags=$(conn_meta "$f" tags); [[ -z "$tags" ]] && continue
    local t; IFS=',' read -ra arr <<< "$tags"
    for t in "${arr[@]}"; do t="${t//[[:space:]]/}"; [[ -n "$t" ]] && counts[$t]=$(( ${counts[$t]:-0} + 1 )); done
  done < <(conn_files)
  [[ ${#counts[@]} -gt 0 ]] || { info "No tags found."; return; }
  {
    printf 'TAG\tCONNECTIONS\n'
    local tag; for tag in $(printf '%s\n' "${!counts[@]}" | sort); do printf '%s\t%s\n' "$tag" "${counts[$tag]}"; done
  } | print_table
}
cmd_tag_rename() {
  [[ $# -ge 2 ]] || die "Usage: sshx tag rename OLD NEW"
  local old="$1" new="$2" count=0
  # Escape special sed BRE metacharacters
  local old_esc new_esc
  old_esc=$(printf '%s' "$old" | sed 's/[[\.*^$()+?{]/\\&/g')
  new_esc=$(printf '%s' "$new" | sed 's/[\\&]/\\&/g')
  check_lock
  while IFS= read -r f; do
    local tags; tags=$(conn_meta "$f" tags); [[ "$tags" == *"$old"* ]] || continue
    local new_tags
    new_tags=$(printf '%s' "$tags" | sed "s/\\(^\\|,\\)${old_esc}\\(,\\|$\\)/\\1${new_esc}\\2/g")
    backup_conn "$f"
    update_meta "$f" tags "$new_tags"
    touch_updated "$f"
    local cname; cname=$(conn_meta "$f" name)
    _tags_sync "$cname" "$new_tags"
    backups_prune
    count=$((count+1))
  done < <(conn_files)
  release_lock
  [[ $count -gt 0 ]] || warn "Tag '${old}' not found on any connection."
  ok "Renamed tag '${old}' → '${new}' on ${count} connection(s)"
}
cmd_export() {
  local all=false format="sshx"; local -a pos=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) all=true; shift ;;
      --format) format="$2"; shift 2 ;;
      --help|-h) printf 'Usage:\n  sshx export NAME [FILE]\n  sshx export --all [FILE]\nOptions:\n  --format sshx|ssh\n'; return ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  if $all; then
    local out="${pos[0]:-/dev/stdout}"
    local tmp_dir; tmp_dir=$(mktemp -d)
    cp "$SSHX_CONNECTIONS_DIR"/*.conf "$tmp_dir/" 2>/dev/null || true
    if [[ "$out" == "/dev/stdout" ]]; then tar -czf - -C "$tmp_dir" . 2>/dev/null
    else tar -czf "$out" -C "$tmp_dir" .; ok "Exported all connections to '${out}'"; fi
    rm -rf "$tmp_dir"; return
  fi
  local name="${pos[0]:-}" file="${pos[1]:-}"
  [[ -n "$name" ]] || die "NAME required. Usage: sshx export NAME [FILE]"
  [[ -f "$(conn_file "$name")" ]] || die "Connection '$name' not found."
  local src; src=$(conn_file "$name")
  if [[ "$format" == "ssh" ]]; then
    if [[ -n "$file" ]]; then grep -v '^# sshx:' "$src" > "$file"; ok "Exported '${name}' (SSH) to '${file}'"; else grep -v '^# sshx:' "$src"; fi
  else
    if [[ -n "$file" ]]; then cp "$src" "$file"; ok "Exported '${name}' to '${file}'"; else cat "$src"; fi
  fi
}
cmd_import() {
  local file="" overwrite=false prefix=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --overwrite) overwrite=true; shift ;;
      --prefix) prefix="$2"; shift 2 ;;
      --help|-h) printf 'Usage: sshx import FILE [--overwrite] [--prefix PREFIX]\n'; return ;;
      *) file="$1"; shift ;;
    esac
  done
  [[ -n "$file" ]] || die "FILE required."
  [[ -f "$file" ]] || die "File not found: ${file}"
  local tmp_dir; tmp_dir=$(mktemp -d)
  if file "$file" 2>/dev/null | grep -qiE "gzip|tar"; then
    tar -xzf "$file" -C "$tmp_dir" 2>/dev/null
  else
    cp "$file" "$tmp_dir/"
  fi
  local imported=0
  shopt -s nullglob
  for f in "$tmp_dir"/*.conf "$tmp_dir"/*.config; do
    [[ -f "$f" ]] || continue
    local iname
    iname=$(awk -F'=' '/^# sshx:name=/{print substr($0,index($0,"=")+1); exit}' "$f" 2>/dev/null || true)
    [[ -z "$iname" ]] && iname=$(awk '/^Host /{print $2; exit}' "$f" 2>/dev/null || true)
    [[ -z "$iname" || "$iname" == "*" ]] && continue
    iname="${prefix}${iname}"
    conn_validate_name "$iname" 2>/dev/null || { warn "Skipping invalid name: '${iname}'"; continue; }
    local dest; dest=$(conn_file "$iname")
    if [[ -f "$dest" ]] && ! $overwrite; then
      warn "Skipping '${iname}' — already exists (use --overwrite)"; continue
    fi
    [[ -f "$dest" ]] && backup_conn "$dest"
    mkdir -p "$(dirname "$dest")"
    cp "$f" "$dest"; chmod 600 "$dest"
    if [[ -n "$prefix" ]]; then
      update_meta "$dest" name "$iname"
      local tmp_pfx; tmp_pfx=$(mktemp); _TEMP_FILES+=("$tmp_pfx"); chmod 600 "$tmp_pfx"
      awk -v n="$iname" '/^Host /{print "Host " n; next}{print}' "$dest" > "$tmp_pfx" && mv "$tmp_pfx" "$dest"
      chmod 600 "$dest"
    fi
    _tags_sync "$iname" "$(conn_meta "$dest" tags)"
    imported=$((imported+1))
    ok "Imported '${iname}'"
  done
  shopt -u nullglob
  rm -rf "$tmp_dir"
  backups_prune
  ok "Imported ${imported} connection(s)"
}
cmd_init() {
  local force=false dry_run=false quiet=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=true; shift ;;
      --dry-run) dry_run=true; shift ;;
      --quiet|-q) quiet=true; shift ;;
      --help|-h) printf 'Usage: sshx init [--force] [--dry-run] [--quiet]\nIdempotent — safe to run multiple times.'; return ;;
      *) die "Unknown flag: $1" ;;
    esac
  done
  local include="Include $SSHX_CONNECTIONS_DIR/*.conf"
  if $dry_run; then
    info "Would create: ${SSHX_CONNECTIONS_DIR}/"
    info "Would create: ${SSHX_TAGS_DIR}/"
    info "Would create: ${SSHX_BACKUPS_DIR}/"
    info "Would add to ${SSH_CONFIG}: ${include}"
    return
  fi
  mkdir -p "$SSHX_CONNECTIONS_DIR" "$SSHX_TAGS_DIR" "$SSHX_BACKUPS_DIR"
  touch "$SSHX_CONNECTIONS_DIR/.gitkeep"
  chmod 700 "$SSHX_HOME" "$SSHX_CONNECTIONS_DIR" "$SSHX_TAGS_DIR" "$SSHX_BACKUPS_DIR"
  $quiet || ok "Initialized ${SSHX_HOME}/"
  mkdir -p "$SSH_HOME"; chmod 700 "$SSH_HOME"
  touch "$SSH_CONFIG"; chmod 600 "$SSH_CONFIG"
  if grep -qF "$include" "$SSH_CONFIG" 2>/dev/null && ! $force; then
    $quiet || info "Include already present in ${SSH_CONFIG}"
  else
    $force && grep -qF "Include.*sshx" "$SSH_CONFIG" 2>/dev/null && {
      local tmp; tmp=$(mktemp)
      grep -v "Include.*sshx" "$SSH_CONFIG" > "$tmp"
      mv "$tmp" "$SSH_CONFIG"; chmod 600 "$SSH_CONFIG"
    }
    local tmp; tmp=$(mktemp)
    { printf '%s\n\n' "$include"; cat "$SSH_CONFIG"; } > "$tmp"
    mv "$tmp" "$SSH_CONFIG"; chmod 600 "$SSH_CONFIG"
    $quiet || ok "Added Include to ${SSH_CONFIG}"
  fi
}
cmd_uninstall() {
  local prefix="/usr/local" dry_run=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prefix) prefix="$2"; shift 2 ;;
      --dry-run) dry_run=true; shift ;;
      --help|-h) printf 'Usage: sshx uninstall [--prefix PREFIX] [--dry-run]\n'; return ;;
      *) shift ;;
    esac
  done
  if $dry_run; then info "Would remove: ${prefix}/bin/sshx"; return; fi
  confirm "Remove sshx from ${prefix}/bin/sshx?" || { info "Aborted."; return; }
  rm -f "${prefix}/bin/sshx"
  ok "Removed ${prefix}/bin/sshx"
  info "Data preserved at: ${SSHX_HOME}"
  info "To remove data:    rm -rf ${SSHX_HOME}"
}
cmd_completion() {
  local shell="${1:-}"
  case "$shell" in
    bash) _completion_bash ;;
    zsh) _completion_zsh ;;
    fish) _completion_fish ;;
    --help|-h) printf 'Usage: sshx completion bash|zsh|fish\n' ;;
    *) die "Unknown shell: '${shell}'. Supported: bash, zsh, fish" ;;
  esac
}
_completion_bash() { cat <<'BASH'
_sshx_connections() {
  local d="${SSHX_HOME:-$HOME/.sshx}/connections"
  [[ -d "$d" ]] || return; local f
  for f in "$d"/*.conf; do [[ -f "$f" ]] && basename "$f" .conf; done
}
_sshx_complete() {
  local cur="${COMP_WORDS[COMP_CWORD]}" cmd="${COMP_WORDS[1]:-}"
  local top="connect list search add show set rm rename copy check edit effective tag export import init config completion uninstall version help"
  local conn_subs="add edit set remove show rename copy check effective"
  local names; names="$(_sshx_connections)"
  case "$cmd" in
    connect|c) COMPREPLY=($(compgen -W "$names" -- "$cur")) ;;
    show|info|set|update|rm|delete|rename|mv|copy|check|ping|edit|effective) COMPREPLY=($(compgen -W "$names" -- "$cur")) ;;
    connection|conn)
      [[ "$COMP_CWORD" -eq 2 ]] && COMPREPLY=($(compgen -W "$conn_subs" -- "$cur")) || COMPREPLY=($(compgen -W "$names" -- "$cur")) ;;
    tag)
      [[ "$COMP_CWORD" -eq 2 ]] && COMPREPLY=($(compgen -W "add remove list rename" -- "$cur")) || { [[ "$sub" != "list" ]] && COMPREPLY=($(compgen -W "$names" -- "$cur")); } ;;
    export) COMPREPLY=($(compgen -W "--all $names" -- "$cur")) ;;
    import) COMPREPLY=($(compgen -f -- "$cur")) ;;
    config) [[ "$COMP_CWORD" -eq 2 ]] && COMPREPLY=($(compgen -W "set get" -- "$cur")) ;;
    completion) COMPREPLY=($(compgen -W "bash zsh fish" -- "$cur")) ;;
    *) [[ "$COMP_CWORD" -eq 1 ]] && COMPREPLY=($(compgen -W "$top" -- "$cur")) ;;
  esac
}
complete -F _sshx_complete sshx
BASH
}
_completion_zsh() { cat <<'ZSH'
_sshx() {
  local d="${SSHX_HOME:-$HOME/.sshx}/connections"
  local -a names=()
  [[ -d "$d" ]] && for f in "$d"/*.conf(N); do names+=("${f:t:r}"); done
  local state
  _arguments -C '1: :->cmd' '*: :->args'
  case $state in
    cmd) _values command connect list search add show set rm rename copy check edit effective tag export import init config completion uninstall version help ;;
    args)
      case ${words[2]} in
        connect|c|show|info|set|update|rm|delete|rename|mv|copy|cp|check|ping|edit|effective)
          _values connection "${names[@]}" ;;
        connection|conn)
          [[ ${#words[@]} -eq 3 ]] && _values subcommand add edit set remove show rename copy check effective || _values connection "${names[@]}" ;;
        tag)
          [[ ${#words[@]} -eq 3 ]] && _values subcommand add remove list rename || _values connection "${names[@]}" ;;
        export) _values name --all "${names[@]}" ;;
        import) _files ;;
        config) _values subcommand set get ;;
        completion) _values shell bash zsh fish ;;
      esac ;;
  esac
}
compdef _sshx sshx
ZSH
}
_completion_fish() { cat <<'FISH'
function __sshx_connections
  set d (set -q SSHX_HOME; and echo $SSHX_HOME; or echo $HOME/.sshx)/connections
  test -d $d; or return
