_dispatch_connection() {
  local sub="${1:-}"; shift || true
  if [[ -z "$sub" || "$sub" == "--help" || "$sub" == "-h" ]]; then
    cat <<EOF
Connection management: sshx connection <subcommand>

Subcommands:
  add       Create a new connection
  edit      Edit in editor
  set       Modify parameters
  remove    Delete (rm, del)
  show      Show details
  rename    Rename
  copy      Duplicate
  check     Validate
  effective Show effective config

For help on a specific subcommand: sshx connection <subcommand> --help
EOF
    return 0
  fi
  case "$sub" in
    add|new|create|a) cmd_connection_add "$@" ;;
    edit|e) cmd_connection_edit "$@" ;;
    set|update|u) cmd_connection_set "$@" ;;
    remove|rm|delete|del) cmd_connection_remove "$@" ;;
    show|info|i) cmd_connection_show "$@" ;;
    rename|mv) cmd_connection_rename "$@" ;;
    copy|cp|clone) cmd_connection_copy "$@" ;;
    check|ping|validate) cmd_connection_check "$@" ;;
    effective|cfg) cmd_connection_effective "$@" ;;
    *) die "Unknown connection subcommand: '${sub}'. Run 'sshx connection --help'." ;;
  esac
}
cmd_connection_add() {
  local description="" tags="" force=false
  local -a ssh_extras=() pos=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --description|-d) description="$2"; shift 2 ;;
      --tags|-t) tags="$2"; shift 2 ;;
      --force|-f) force=true; shift ;;
      --help|-h) printf 'Usage: sshx add [NAME] USER@HOST[:PORT] [options]\n\nOptions:\n  -d, --description TEXT\n  -t, --tags TAG1,TAG2\n  --force\n  --<ssh-param> VALUE\n'; return ;;
      --*=*) local _f="${1%%=*}"; ssh_extras+=("${_f#--}" "${1#*=}"); shift ;;
      --*) 
        if [[ $# -ge 2 ]]; then
          ssh_extras+=("${1#--}" "$2"); shift 2
        else
          die "Option --${1#--} requires a value"
        fi
        ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  local name="" conn_str=""
  case "${#pos[@]}" in
    0) die "USER@HOST[:PORT] required." ;;
    1) conn_str="${pos[0]}" ;;
    *) name="${pos[0]}"; conn_str="${pos[1]}" ;;
  esac
  if [[ -z "$name" ]]; then
    local _u _h _p; parse_conn_string "$conn_str" _u _h _p
    name="${_h%%.*}"; name="${name//[^a-zA-Z0-9._-]/-}"
  fi
  conn_validate_name_or_die "$name"
  mkdir -p "$SSHX_CONNECTIONS_DIR"
  local file; file=$(conn_file "$name")
  if [[ -f "$file" ]] && ! $force; then die "Connection '${name}' already exists. Use --force to overwrite."; fi
  check_lock
  backup_conn "$file"
  write_conn_file "$file" "$name" "$conn_str" "$description" "$tags"
  if [[ ${#ssh_extras[@]} -gt 0 ]]; then apply_ssh_flags "$file" "${ssh_extras[@]}"; fi
  _tags_sync "$name" "$(conn_meta "$file" tags)"
  backups_prune
  release_lock
  ok "Created connection '${name}' → ${conn_str}"
}
cmd_connection_set() {
  if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    cat <<EOF
Usage: sshx set NAME [options]

Options:
  --description, -d TEXT    Set description
  --tags, -t TAG1,TAG2      Replace tags
  --remove DIRECTIVE        Remove an SSH directive (e.g., Port)
  --add DIRECTIVE VALUE     Add a raw SSH directive
  --<ssh-option> VALUE      Set any SSH option (e.g., --identity=file)
EOF
    return 0
  fi
  [[ $# -ge 1 ]] || die "Usage: sshx set NAME [options]"
  local name="$1"; shift
  conn_validate_name_or_die "$name"
  local file; file=$(conn_file "$name")
  [[ -f "$file" ]] || die "Connection '$name' not found."
  check_lock
  backup_conn "$file"
  local description="" tags=""
  local -a to_remove=() to_add=() ssh_flags=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --description|-d) description="$2"; shift 2 ;;
      --tags|-t) tags="$2"; shift 2 ;;
      --remove) to_remove+=("$2"); shift 2 ;;
      --add) to_add+=("$2" "$3"); shift 3 ;;
      --*=*) local _f="${1%%=*}"; ssh_flags+=("${_f#--}" "${1#*=}"); shift ;;
      --*) 
        if [[ $# -ge 2 ]]; then
          ssh_flags+=("${1#--}" "$2"); shift 2
        else
          die "Option --${1#--} requires a value"
        fi
        ;;
      *) die "Unknown argument: $1" ;;
    esac
  done
  [[ -n "$description" ]] && update_meta "$file" description "$description"
  if [[ -n "$tags" ]]; then update_meta "$file" tags "$tags"; _tags_sync "$name" "$tags"; fi
  local param; for param in "${to_remove[@]}"; do remove_ssh_directive "$file" "$param"; done
  local i=0
  if [[ ${#to_add[@]} -gt 0 ]]; then
    local tmp_add; tmp_add=$(mktemp); _TEMP_FILES+=("$tmp_add"); chmod 600 "$tmp_add"
    cp "$file" "$tmp_add"
    while [[ $i -lt ${#to_add[@]} ]]; do
      printf '    %s %s\n' "${to_add[$i]}" "${to_add[$((i+1))]}" >> "$tmp_add"
      i=$((i+2))
    done
    mv "$tmp_add" "$file"; chmod 600 "$file"
  fi
  if [[ ${#ssh_flags[@]} -gt 0 ]]; then apply_ssh_flags "$file" "${ssh_flags[@]}"; fi
  touch_updated "$file"
  backups_prune
  release_lock
  ok "Updated connection '${name}'"
}
cmd_connection_show() {
  [[ $# -ge 1 ]] || die "Usage: sshx show NAME"
  local name="$1" format="pretty"; shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --format) format="$2"; shift 2 ;;
      --json) format="json"; shift ;;
      --help|-h) printf 'Usage: sshx show NAME [--format pretty|raw|json]\n'; return ;;
      *) die "Unknown flag: $1" ;;
    esac
  done
  local file; file=$(conn_file "$name")
  [[ -f "$file" ]] || die "Connection '$name' not found."
  case "$format" in
    raw) cat "$file" ;;
    json)
      local n h po u d tg cr up cs
      n=$(conn_meta "$file" name); h=$(conn_ssh "$file" HostName)
      po=$(conn_ssh "$file" Port); [[ -n "$po" ]] || po="22"
      u=$(conn_ssh "$file" User); d=$(conn_meta "$file" description)
      tg=$(conn_meta "$file" tags); cr=$(conn_meta "$file" created_at)
      up=$(conn_meta "$file" updated_at); cs=$(conn_meta "$file" connection_string)
      printf '{"name":"%s","host":"%s","port":"%s","user":"%s","description":"%s","tags":"%s","created_at":"%s","updated_at":"%s","connection_string":"%s"}\n' \
        "$(json_escape "$n")" "$(json_escape "$h")" "$(json_escape "$po")" "$(json_escape "$u")" \
        "$(json_escape "$d")" "$(json_escape "$tg")" "$(json_escape "$cr")" "$(json_escape "$up")" \
        "$(json_escape "$cs")"
      ;;
    *)
      local n h po u d tg cr up
      n=$(conn_meta "$file" name); h=$(conn_ssh "$file" HostName)
      po=$(conn_ssh "$file" Port); [[ -n "$po" ]] || po="22"
      u=$(conn_ssh "$file" User); d=$(conn_meta "$file" description)
      tg=$(conn_meta "$file" tags); cr=$(conn_meta "$file" created_at)
      up=$(conn_meta "$file" updated_at)
      printf '%s%-18s%s %s\n' "$(color bold)" "Name:" "$(color reset)" "$n"
      printf '%-18s %s\n' "Host:" "$h"; printf '%-18s %s\n' "Port:" "$po"
      [[ -n "$u" ]] && printf '%-18s %s\n' "User:" "$u"
      [[ -n "$d" ]] && printf '%-18s %s\n' "Description:" "$d"
      [[ -n "$tg" ]] && printf '%-18s %s\n' "Tags:" "$tg"
      [[ -n "$cr" ]] && printf '%-18s %s\n' "Created:" "$cr"
      [[ -n "$up" ]] && printf '%-18s %s\n' "Updated:" "$up"
      printf '\n%s--- SSH Config ---%s\n' "$(color gray)" "$(color reset)"
      grep -v '^# sshx:' "$file" | grep -v '^[[:space:]]*$'
      ;;
  esac
}
cmd_connection_rename() {
  [[ $# -ge 2 ]] || die "Usage: sshx rename OLD NEW"
  local old="$1" new="$2"
  if [[ ! -f "$(conn_file "$old")" ]]; then die "Connection '$old' not found."; fi
  conn_validate_name_or_die "$new"
  check_lock
  local old_file; old_file=$(conn_file "$old")
  local new_file; new_file=$(conn_file "$new")
  [[ ! -f "$new_file" ]] || die "Connection '${new}' already exists."
  backup_conn "$old_file"
  local tmp; tmp=$(mktemp); chmod 600 "$tmp"
  awk -v o="$old" -v n="$new" 'BEGIN{FS=OFS="="} /^# sshx:name=/{print "# sshx:name=" n; next} {print}' "$old_file" > "$tmp"
  awk -v o="$old" -v n="$new" '/^Host /{if($2==o){print "Host " n; next}} {print}' "$tmp" > "$new_file"
  chmod 600 "$new_file"
  rm -f "$old_file"
  _tags_remove_all "$old"
  _tags_sync "$new" "$(conn_meta "$new_file" tags)"
  touch_updated "$new_file"
  backups_prune
  release_lock
  ok "Renamed '${old}' → '${new}'"
}
cmd_connection_copy() {
  [[ $# -ge 2 ]] || die "Usage: sshx copy SOURCE NEW"
  local src="$1" new="$2"; shift 2
  [[ -f "$(conn_file "$src")" ]] || die "Connection '$src' not found."
  conn_validate_name_or_die "$new"
  local src_file; src_file=$(conn_file "$src")
  local new_file; new_file=$(conn_file "$new")
  [[ ! -f "$new_file" ]] || die "Connection '${new}' already exists."
  check_lock
  local now; now=$(utc_now)
  local tmp; tmp=$(mktemp); chmod 600 "$tmp"
  awk -v n="$new" -v now="$now" 'BEGIN{FS=OFS="="} /^# sshx:name=/{print "# sshx:name=" n; next} /^# sshx:created_at=/{print "# sshx:created_at=" now; next} /^# sshx:updated_at=/{print "# sshx:updated_at=" now; next} {print}' "$src_file" > "$tmp"
  awk -v s="$src" -v n="$new" '/^Host /{if($2==s){$2=n; print; next}} {print}' "$tmp" > "$new_file"
  chmod 600 "$new_file"
  if [[ $# -gt 0 ]]; then cmd_connection_set "$new" "$@" 2>/dev/null || true; fi
  _tags_sync "$new" "$(conn_meta "$new_file" tags)"
  backups_prune
  release_lock
  ok "Copied '${src}' → '${new}'"
}
cmd_connection_remove() {
  [[ $# -ge 1 ]] || die "Usage: sshx rm NAME"
  local name="$1" force=false no_backup=false; shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=true; shift ;;
      --no-backup) no_backup=true; shift ;;
      --help|-h) printf 'Usage: sshx rm NAME [--force] [--no-backup]\n'; return ;;
      *) die "Unknown flag: $1" ;;
    esac
  done
  local file; file=$(conn_file "$name")
  [[ -f "$file" ]] || die "Connection '$name' not found."
  $force || confirm "Delete connection '${name}'?" || { info "Aborted."; return; }
  check_lock
  $no_backup || backup_conn "$file"
  rm -f "$file"
  _tags_remove_all "$name"
  backups_prune
  release_lock
  ok "Removed connection '${name}'"
}
cmd_connection_check() {
  [[ $# -ge 1 ]] || die "Usage: sshx check NAME"
  local name="$1" config_only=false timeout=5; shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --config-only) config_only=true; shift ;;
      --timeout) timeout="$2"; shift 2 ;;
      --help|-h) printf 'Usage: sshx check NAME [--config-only] [--timeout N]\n'; return ;;
      *) die "Unknown flag: $1" ;;
    esac
  done
  local file; file=$(conn_file "$name")
  [[ -f "$file" ]] || die "Connection '$name' not found."
  if "$SSH_BIN" -G "$name" &>/dev/null; then ok "Config valid (ssh -G passed)"; else die "Config invalid — run '${SSH_BIN} -G ${name}' for details."; fi
  $config_only && return
  info "Testing connectivity (timeout ${timeout}s)…"
  if "$SSH_BIN" -o BatchMode=yes -o ConnectTimeout="$timeout" -o StrictHostKeyChecking=accept-new "$name" exit 0 &>/dev/null; then ok "Connection successful"; else warn "Could not connect (unreachable or requires interactive auth)"; fi
}
cmd_connection_edit() {
  [[ $# -ge 1 ]] || die "Usage: sshx edit NAME"
  local name="$1"; shift
  local file; file=$(conn_file "$name")
  [[ -f "$file" ]] || die "Connection '$name' not found."
  check_lock
  backup_conn "$file"
  release_lock
  "$(cfg_get editor)" "$file"
  check_lock
  touch_updated "$file"
  backups_prune
  release_lock
  "$SSH_BIN" -G "$name" &>/dev/null && ok "Saved. Config valid." || warn "SSH config syntax error. Check with: ${SSH_BIN} -G ${name}"
}
cmd_connection_effective() {
  [[ $# -ge 1 ]] || die "Usage: sshx effective NAME"
  if [[ ! -f "$(conn_file "$1")" ]]; then die "Connection '$1' not found."; fi
  "$SSH_BIN" -G "$1"
}
cmd_exec() {
  if [[ "$1" == "--help" || "$1" == "-h" ]]; then
    cat <<EOF
Usage: sshx exec [--parallel] HOST|tag:TAG COMMAND

Execute a command on one or more hosts.

Options:
  --parallel    Run command in parallel on all hosts

Examples:
  sshx exec myserver 'uptime'
  sshx exec --parallel tag:prod 'df -h'
EOF
    return 0
  fi
  local parallel=false
  if [[ "${1:-}" == "--parallel" ]]; then parallel=true; shift; fi
  [[ $# -ge 2 ]] || die "Usage: sshx exec [--parallel] HOST|tag:TAG COMMAND"
  local target="$1"; shift
  local cmd="$*"
  local -a hosts=()
  if [[ "$target" == tag:* ]]; then
    local tag="${target#tag:}"
    if [[ -d "$SSHX_TAGS_DIR/$tag" ]]; then
      local l
      for l in "$SSHX_TAGS_DIR/$tag"/*; do [[ -L "$l" ]] || continue; hosts+=("$(basename "$l")"); done
    else
      die "Tag not found: $tag"
    fi
  else
    hosts+=("$target")
  fi
  [[ ${#hosts[@]} -gt 0 ]] || die "No hosts found for target: $target"
  if $parallel; then
    local -a pids=() tmpfiles=() hostnames=()
    local h tmpfile
    for h in "${hosts[@]}"; do
      tmpfile=$(mktemp "$SSHX_HOME/exec.XXXXXX")
      _TEMP_FILES+=("$tmpfile")
      ("$SSH_BIN" "$h" -- sh -c "$cmd") >"$tmpfile" 2>&1 &
      pids+=("$!")
      tmpfiles+=("$tmpfile")
      hostnames+=("$h")
    done
    local i
    for i in "${!pids[@]}"; do
      wait "${pids[$i]}" 2>/dev/null || true
      printf '--- %s ---\n' "${hostnames[$i]}"
      cat "${tmpfiles[$i]}"
      rm -f "${tmpfiles[$i]}"
    done
  else
    local h
    for h in "${hosts[@]}"; do
      printf '--- %s ---\n' "$h"
      "$SSH_BIN" "$h" -- sh -c "$cmd"
    done
  fi
}
main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    help|--help|-h)
      if [[ "$cmd" == "help" ]]; then
        cmd_help_full
      else
        cmd_help_brief
      fi
      ;;
    connect|c|ssh) cmd_connect "$@" ;;
    list|ls) cmd_list "$@" ;;
    search|find|f) cmd_search "$@" ;;
    add|new|create|a) cmd_connection_add "$@" ;;
    show|info|i) cmd_connection_show "$@" ;;
    set|update|u) cmd_connection_set "$@" ;;
    rm|remove|delete|del) cmd_connection_remove "$@" ;;
    rename|mv) cmd_connection_rename "$@" ;;
    copy|cp|clone) cmd_connection_copy "$@" ;;
    check|ping) cmd_connection_check "$@" ;;
    edit|e) cmd_connection_edit "$@" ;;
    effective|cfg) cmd_connection_effective "$@" ;;
    connection|conn) _dispatch_connection "$@" ;;
    tag)
      local sub="${1:-}"; shift || true
      if [[ -z "$sub" || "$sub" == "--help" || "$sub" == "-h" ]]; then
        cat <<EOF
Tag management: sshx tag <subcommand>

Subcommands:
  add    NAME TAG[,TAG2...]   Add tags to a connection
  remove NAME TAG[,TAG2...]   Remove tags from a connection
  list                        Show all tags
  rename OLD NEW              Rename a tag across all connections

For help on a specific subcommand: sshx tag <subcommand> --help
EOF
        return 0
      fi
      case "$sub" in
        add) cmd_tag_add "$@" ;;
        remove) cmd_tag_remove "$@" ;;
        list) cmd_tag_list "$@" ;;
        rename) cmd_tag_rename "$@" ;;
        *) die "Unknown tag subcommand: '${sub}'." ;;
      esac ;;
    export) cmd_export "$@" ;;
    import) cmd_import "$@" ;;
    init) cmd_init "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    config)
      local sub="${1:-get}"; shift || true
      if [[ -z "$sub" || "$sub" == "--help" || "$sub" == "-h" ]]; then
        cat <<EOF
Configuration management: sshx config <subcommand>

Subcommands:
  get [KEY]   Get value (all if key omitted)
  set KEY VALUE Set value

Keys: editor, backup_enabled, backup_max_age_days, color, fzf_preview, default_tags
EOF
        return 0
      fi
      case "$sub" in
        set) cmd_config_set "$@" ;;
        get) cmd_config_get "$@" ;;
        *) die "Unknown config subcommand: '${sub}'." ;;
      esac ;;
    completion) cmd_completion "$@" ;;
    exec) cmd_exec "$@" ;;
    version|--version|-V) printf '%s\n' "$SSHX_VERSION" ;;
    license|--license|-L) printf '%s\n' "$SSHX_LICENSE" ;;
    *) die "Unknown command: '${cmd}'. Run 'sshx help'." ;;
  esac
}
main "$@"
